<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.blinklink.platform</groupId>
        <artifactId>blinklink-platform-starters</artifactId>
        <version>0.1.9</version>
    </parent>

    <artifactId>blinklink-contract-testing</artifactId>
    <name>blinklink-contract-testing</name>
    <description>Contract-test fixtures: real controller responses validated against the published compose spec's schemas (OpenAPI 3.1 = JSON Schema 2020-12)</description>

    <dependencies>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
        </dependency>

        <!-- Optional: consumers bring their own pinned spec artifact; this module's tests use it too. -->
        <dependency>
            <groupId>com.blinklink.platform</groupId>
            <artifactId>blinklink-compose-spec</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
